<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoliMusic - Configuracion IIS de la aplicacion
  Se aplica automaticamente al publicar la carpeta del sitio en IIS.
  Nota: la seccion <asp> se configura a nivel de servidor (ver DEPLOY.md)
        porque IIS la bloquea por defecto en los web.config de aplicacion.
-->
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="default.asp" />
                <add value="index.asp" />
                <add value="iisstart.htm" />
            </files>
        </defaultDocument>

        <directoryBrowse enabled="false" />

        <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

        <staticContent>
            <remove fileExtension=".mp3" />
            <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
            <remove fileExtension=".m4a" />
            <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
            <remove fileExtension=".ogg" />
            <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
            <remove fileExtension=".wav" />
            <mimeMap fileExtension=".wav" mimeType="audio/wav" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
